{
  "manifest_version": 3,
  "name": "__MSG_manifest_ext_name__",
  "version": "0.1.0.3",
  "version_name": "0.1.0-rc.3",
  "description": "__MSG_manifest_ext_description__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "alarms",
    "sidePanel",
    "storage",
    "scripting",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://api.cursor.com/*",
    "https://cursor.com/*",
    "https://account.jetbrains.com/*",
    "https://*.jetbrains.com/*",
    "https://api.anthropic.com/*",
    "https://platform.claude.com/*",
    "https://api.chatgpt.com/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "__MSG_manifest_action_default_title__",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "default_locale": "en"
}
